# Makefile for torrentinfo (GNU make, Linux)
#
#   make                 build the library and the torrentinfo program
#   make debug           build with AddressSanitizer and UBSan in build/debug
#   make lib             build only libtorrentinfo.a
#   make install         install program, library and headers under $(PREFIX)
#   make uninstall       remove what 'make install' installed
#   make clean           remove all build output
#
# Variables you can override:  make CC=clang PREFIX=$HOME/.local V=1

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

CC         ?= cc
PKG_CONFIG ?= pkg-config
PREFIX     ?= /usr/local
DESTDIR    ?=

BINDIR     := $(PREFIX)/bin
LIBDIR     := $(PREFIX)/lib
INCLUDEDIR := $(PREFIX)/include/torrentinfo

PROGRAM    := torrentinfo
LIBRARY    := libtorrentinfo.a

SRCDIR      := src

LIB_SOURCES := platform.c net.c extension.c parser.c encoder.c http.c udp.c tracker.c message.c peer.c piece.c storage.c download.c announce.c portmap.c
APP_SOURCES := main.c
HEADERS     := queue.h platform.h net.h extension.h parser.h encoder.h http.h udp.h tracker.h message.h peer.h piece.h storage.h download.h announce.h portmap.h

PKGS := libuv openssl

# Fail early with a clear message if a dependency is missing.
ifeq ($(filter clean uninstall,$(MAKECMDGOALS)),)
  ifneq ($(shell $(PKG_CONFIG) --exists $(PKGS) && echo yes),yes)
    $(error Missing development packages. On Debian/Ubuntu: \
            apt install libuv1-dev libssl-dev pkg-config)
  endif
  PKG_CFLAGS := $(shell $(PKG_CONFIG) --cflags $(PKGS))
  PKG_LIBS   := $(shell $(PKG_CONFIG) --libs $(PKGS))
endif

# _POSIX_C_SOURCE is needed for <uv.h> under strict -std=c99.
CPPFLAGS += -D_POSIX_C_SOURCE=200809L
CFLAGS   ?= -O2 -g
CFLAGS   += -std=c99 -Wall -Wextra -Wpedantic -Wshadow -Wconversion
CFLAGS   += -MMD -MP $(PKG_CFLAGS)
LDLIBS   += $(PKG_LIBS)

# Sources are in src/; release builds go in build/release, debug builds in
# build/debug.
BUILD := build/release
ifeq ($(MAKECMDGOALS),debug)
  BUILD   := build/debug
  CFLAGS  += -O1 -fno-omit-frame-pointer -fsanitize=address,undefined
  LDFLAGS += -fsanitize=address,undefined
endif

LIB_OBJECTS := $(LIB_SOURCES:%.c=$(BUILD)/%.o)
APP_OBJECTS := $(APP_SOURCES:%.c=$(BUILD)/%.o)
DEPENDS     := $(LIB_OBJECTS:.o=.d) $(APP_OBJECTS:.o=.d)

# Quiet output; 'make V=1' shows full commands.
ifeq ($(V),1)
  Q :=
  say :=
else
  Q := @
  say = @printf '  %-6s %s\n' $(1) $(2);
endif

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------

.PHONY: all debug lib install uninstall clean

all: $(BUILD)/$(PROGRAM)
	$(Q)ln -sf $(BUILD)/$(PROGRAM) $(PROGRAM)

debug: $(BUILD)/$(PROGRAM)
	@echo "Debug build: $(BUILD)/$(PROGRAM)"

lib: $(BUILD)/$(LIBRARY)

$(BUILD)/$(PROGRAM): $(APP_OBJECTS) $(BUILD)/$(LIBRARY)
	$(call say,LINK,$@)
	$(Q)$(CC) $(LDFLAGS) -o $@ $(APP_OBJECTS) $(BUILD)/$(LIBRARY) $(LDLIBS)

$(BUILD)/$(LIBRARY): $(LIB_OBJECTS)
	$(call say,AR,$@)
	$(Q)rm -f $@
	$(Q)$(AR) rcs $@ $^

$(BUILD)/%.o: $(SRCDIR)/%.c | $(BUILD)
	$(call say,CC,$<)
	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

$(BUILD):
	$(Q)mkdir -p $@

install: all
	install -d $(DESTDIR)$(BINDIR) $(DESTDIR)$(LIBDIR) $(DESTDIR)$(INCLUDEDIR)
	install -m 755 $(BUILD)/$(PROGRAM) $(DESTDIR)$(BINDIR)/$(PROGRAM)
	install -m 644 $(BUILD)/$(LIBRARY) $(DESTDIR)$(LIBDIR)/$(LIBRARY)
	install -m 644 $(addprefix $(SRCDIR)/,$(HEADERS)) $(DESTDIR)$(INCLUDEDIR)/

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/$(PROGRAM)
	rm -f $(DESTDIR)$(LIBDIR)/$(LIBRARY)
	rm -f $(addprefix $(DESTDIR)$(INCLUDEDIR)/,$(HEADERS))
	-rmdir $(DESTDIR)$(INCLUDEDIR) 2>/dev/null

clean:
	rm -rf build $(PROGRAM)

# Header dependencies generated by -MMD.
-include $(DEPENDS)

<?xml version="1.0" encoding="utf-8"?>
<!--
  libaTorrentDll: the BitTorrent library as libaTorrent.dll, exporting only the
  ATORRENT_API functions of aTorrent.h. Programs define ATORRENT_DLL and link
  with the import library libaTorrent.dll.lib (named so that it does not clash
  with the static libaTorrent.lib in the same folder).
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{7A3C1E52-9B0D-4F61-A2E8-5C4D93B7E116}</ProjectGuid>
    <RootNamespace>libaTorrentDll</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />

  <!-- Install libuv and OpenSSL from vcpkg.json (requires "vcpkg integrate install" once; see BUILDING.md). -->
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
  </PropertyGroup>

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>libaTorrent</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <WarningLevel>Level3</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- WIN32_LEAN_AND_MEAN keeps <windows.h> from including the old <winsock.h>,
           which would clash with the <winsock2.h> that libuv uses. -->
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;_WIN32_WINNT=0x0A00;_CRT_SECURE_NO_WARNINGS;ATORRENT_BUILDING_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ImportLibrary>$(OutDir)libaTorrent.dll.lib</ImportLibrary>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Windows libraries used by libuv, OpenSSL and the certificate store code. -->
      <AdditionalDependencies>ws2_32.lib;iphlpapi.lib;userenv.lib;psapi.lib;dbghelp.lib;ole32.lib;shell32.lib;user32.lib;advapi32.lib;crypt32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\aTorrent.c" />
    <ClCompile Include="src\bandwidth.c" />
    <ClCompile Include="src\bencode.c" />
    <ClCompile Include="src\datafile.c" />
    <ClCompile Include="src\event.c" />
    <ClCompile Include="src\selection.c" />
    <ClCompile Include="src\session.c" />
    <ClCompile Include="src\settings.c" />
    <ClCompile Include="src\torrent.c" />
    <ClCompile Include="src\platform.c" />
    <ClCompile Include="src\net.c" />
    <ClCompile Include="src\parser.c" />
    <ClCompile Include="src\encoder.c" />
    <ClCompile Include="src\http.c" />
    <ClCompile Include="src\udp.c" />
    <ClCompile Include="src\tracker.c" />
    <ClCompile Include="src\message.c" />
    <ClCompile Include="src\peer.c" />
    <ClCompile Include="src\piece.c" />
    <ClCompile Include="src\storage.c" />
    <ClCompile Include="src\download.c" />
    <ClCompile Include="src\announce.c" />
    <ClCompile Include="src\extension.c" />
    <ClCompile Include="src\portmap.c" />
    <ClCompile Include="src\magnet.c" />
    <ClCompile Include="src\metadata.c" />
    <ClCompile Include="src\dht.c" />
    <ClCompile Include="src\blocklist.c" />
    <ClCompile Include="src\config.c" />
    <ClCompile Include="src\crypto.c" />
    <ClCompile Include="src\webseed.c" />
    <ClCompile Include="src\resume.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\aTorrent.h" />
    <ClInclude Include="src\queue.h" />
    <ClInclude Include="src\bandwidth.h" />
    <ClInclude Include="src\bencode.h" />
    <ClInclude Include="src\datafile.h" />
    <ClInclude Include="src\event.h" />
    <ClInclude Include="src\selection.h" />
    <ClInclude Include="src\session.h" />
    <ClInclude Include="src\settings.h" />
    <ClInclude Include="src\torrent.h" />
    <ClInclude Include="src\platform.h" />
    <ClInclude Include="src\net.h" />
    <ClInclude Include="src\parser.h" />
    <ClInclude Include="src\encoder.h" />
    <ClInclude Include="src\http.h" />
    <ClInclude Include="src\udp.h" />
    <ClInclude Include="src\tracker.h" />
    <ClInclude Include="src\message.h" />
    <ClInclude Include="src\peer.h" />
    <ClInclude Include="src\piece.h" />
    <ClInclude Include="src\storage.h" />
    <ClInclude Include="src\download.h" />
    <ClInclude Include="src\announce.h" />
    <ClInclude Include="src\extension.h" />
    <ClInclude Include="src\portmap.h" />
    <ClInclude Include="src\magnet.h" />
    <ClInclude Include="src\metadata.h" />
    <ClInclude Include="src\dht.h" />
    <ClInclude Include="src\blocklist.h" />
    <ClInclude Include="src\config.h" />
    <ClInclude Include="src\crypto.h" />
    <ClInclude Include="src\webseed.h" />
    <ClInclude Include="src\resume.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="vcpkg.json" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
